<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_compose"
            app:titleTextAppearance="@style/TextAppearance.ReachInbox.CardTitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseTemplate"
                style="@style/Widget.ReachInbox.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Use Template"
                android:textAppearance="@style/TextAppearance.ReachInbox.Label"
                android:textColor="@color/md_theme_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAiImprove"
                style="@style/Widget.ReachInbox.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/spacing_8"
                android:text="@string/btn_ai_improve"
                android:textAppearance="@style/TextAppearance.ReachInbox.Label"
                android:textColor="@color/md_theme_primary"
                app:icon="@drawable/ic_magic_wand"
                app:iconTint="@color/md_theme_primary" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Normal Composer UI -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/composerUi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSender"
                    style="@style/Widget.ReachInbox.TextInputLayout.ExposedDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_from"
                    app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                    app:hintTextColor="@color/md_theme_primary">

                    <AutoCompleteTextView
                        android:id="@+id/actvSender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRecipient"
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="@string/hint_to">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRecipient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSubject"
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="@string/hint_subject"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="200"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBody"
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="@string/hint_message">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="8"
                        android:maxLength="12000"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveDraft"
                        style="@style/Widget.ReachInbox.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_save_draft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSchedule"
                        style="@style/Widget.ReachInbox.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:text="@string/btn_schedule" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        style="@style/Widget.ReachInbox.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_send"
                        app:icon="@drawable/ic_send" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="24dp" />
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Empty State: Zero Senders -->
        <LinearLayout
            android:id="@+id/emptyStateZeroSenders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_32"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:contentDescription="@null"
                android:src="@drawable/ic_sender_disconnected"
                app:tint="@color/md_theme_outline" />

            <TextView
                style="@style/TextAppearance.ReachInbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="No sender connected" />

            <TextView
                style="@style/TextAppearance.ReachInbox.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center"
                android:text="Connect and verify an email account\nbefore composing or sending emails." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSender"
                style="@style/Widget.ReachInbox.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="Add Sender" />
        </LinearLayout>

        <!-- Empty State: No Connected Senders -->
        <LinearLayout
            android:id="@+id/emptyStateNoConnected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_32"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/colorWarning" />

            <TextView
                style="@style/TextAppearance.ReachInbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="No verified sender" />

            <TextView
                style="@style/TextAppearance.ReachInbox.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center"
                android:text="Your sender account needs to be verified\nbefore you can compose emails." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageSenders"
                style="@style/Widget.ReachInbox.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="Manage Senders" />
        </LinearLayout>

        <!-- Loading State -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/initialLoadingProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
