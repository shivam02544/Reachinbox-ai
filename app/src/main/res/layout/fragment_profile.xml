<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/spacing_24"
            app:cardBackgroundColor="@color/md_theme_primaryContainer"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_picture_description"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProfileInitials"
                style="@style/TextAppearance.ReachInbox.Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/md_theme_primary"
                android:textSize="30sp"
                android:visibility="visible" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvProfileName"
            style="@style/TextAppearance.ReachInbox.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center"
            android:text="@string/default_user_name" />

        <TextView
            android:id="@+id/tvProfileEmail"
            style="@style/TextAppearance.ReachInbox.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:gravity="center"
            android:text="@string/default_user_email" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ReachInbox.Card.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16">

                <TextView
                    style="@style/TextAppearance.ReachInbox.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_information"
                    android:textAllCaps="true" />

                <TextView
                    style="@style/TextAppearance.ReachInbox.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/profile_name_label" />

                <TextView
                    android:id="@+id/tvProfileNameValue"
                    style="@style/TextAppearance.ReachInbox.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="@string/default_user_name" />

                <TextView
                    style="@style/TextAppearance.ReachInbox.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/profile_email_label" />

                <TextView
                    android:id="@+id/tvProfileEmailValue"
                    style="@style/TextAppearance.ReachInbox.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="@string/default_user_email" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileSettings"
            style="@style/Widget.ReachInbox.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/nav_settings"
            app:icon="@drawable/ic_settings" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
