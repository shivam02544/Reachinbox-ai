<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_create_campaign"
            app:titleTextAppearance="@style/TextAppearance.ReachInbox.CardTitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/creationProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="1"
            app:trackThickness="4dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.ReachInbox.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Campaign Content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseTemplate"
                        style="@style/Widget.ReachInbox.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use Template"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Label"
                        android:textColor="@color/md_theme_primary" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.ReachInbox.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Define the core message for your outreach." />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:hint="Campaign Name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCampaignName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="Subject Line">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ReachInbox.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="Email Body">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="10"
                        android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: Sender -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/TextAppearance.ReachInbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Sender" />

            <TextView
                style="@style/TextAppearance.ReachInbox.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="Choose the verified account to send from." />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ReachInbox.TextInputLayout.ExposedDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:hint="Sender Account"
                app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                app:hintTextColor="@color/md_theme_onSurfaceVariant">

                <AutoCompleteTextView
                    android:id="@+id/actvSender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/noSenderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvNoSender"
                    style="@style/TextAppearance.ReachInbox.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No connected sender available."
                    android:textColor="@color/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSender"
                style="@style/Widget.ReachInbox.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:text="Add Sender"
                    android:textColor="@color/md_theme_primary" />
            </LinearLayout>

        </LinearLayout>

        <!-- Step 3: Recipients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/TextAppearance.ReachInbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Recipients" />

            <TextView
                style="@style/TextAppearance.ReachInbox.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="Enter emails separated by commas or new lines." />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ReachInbox.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_24"
                android:layout_weight="1"
                android:hint="Recipients">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecipients"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:textAppearance="@style/TextAppearance.ReachInbox.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvRecipientCount"
                style="@style/TextAppearance.ReachInbox.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="0 recipients" />
        </LinearLayout>
    </ViewFlipper>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_theme_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.ReachInbox.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Back"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.ReachInbox.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:text="Next" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

</LinearLayout>
