{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config",
      "<rootDir>/src/tests/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/jest.cleanup.js"
    ]
  },
  "keywords": [
    "reachinbox",
    "backend",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "1.1.1",
    "pdf2json": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.21.1",
    "supertest": "^7.2.2"
  }
}
