# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# These are used by Docker Compose to initialize the database
DB_USER=reachinbox_user
DB_PASSWORD=reachinbox_password
DB_NAME=reachinbox_db
DB_PORT=5432

# Prisma Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use 'localhost' if running the backend outside of Docker, or the service name 'postgres' if inside Docker.
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# CORS Configuration (comma separated origins)
ALLOWED_ORIGINS="http://localhost:3000"

# Authentication Configuration
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Encryption Configuration
# Must be at least 32 characters
ENCRYPTION_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
GEMINI_API_KEY=  
GEMINI_MODEL=gemini-1.5-pro 
